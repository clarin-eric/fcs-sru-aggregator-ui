  "help": {
    "title": "Help",
    "performSearch": {
      "title": "Performing a Federated Content Search in resources",
      "textBasicSearch": "To perform a <strong>simple keyword search</strong> in all CLARIN Federated Content Search centres and their resources, go to the search field at the top of the page or switch to <em>Text Layer Contextual Query Language (CQL)</em> in the dropdown list, enter your query, and click the <em>Search</em> button or press the <kbd>Enter</kbd> key.",
      "textAdvancedSearch": "To perform an <strong>advanced search on multiple annotation layers</strong> in CLARIN Federated Content Search centres that support this, switch to <em>Multi-layer Federated Content Search (FCS-QL)</em> in the dropdown list, enter your query or create a query in the Graphical Query Builder by clicking the button with the magic wand <iconMagicWand/>, and then click the <em>Search</em> button or press the <kbd>Enter</kbd> key.",
      "textLexicalSearch": "To perform an <strong>lexical search on field of lexical entries</strong> in CLARIN Federated Content Search centres that support this, switch to <em>Lexical Resources Contextual Query Language (LexCQL)</em> in the dropdown list, enter your query or create a query in the Graphical Query Builder by clicking the button with the magic wand <iconMagicWand/>, and then click the <em>Search</em> button or press the <kbd>Enter</kbd> key.",
      "textSearchProgress": "When the search starts, the page will start filling in with the resource responses. After the entire search process has ended you have the option to download the results in various formats.",
      "textViewResource": "If you are particularly interested in the results returned by a resource, you have the option to focus only on the results of that resource, by clicking on the <iconEye/> <em>View</em> button. In this view mode you can also download the results in various formats or use the WebLicht processing services to further analyse the results."
    },
    "adjustSearchCriteria": {
      "title": "Adjusting search criteria",
      "text": "The FCS Aggregator allows to select specific resources based on their title or language and to specify the number of search results (hits) per resource per page. The user interface controls that allows to change these options are located right below the search fiels on the main page. The current options are to filter resources based on their language, to select specific resources, and to set the maximum number of hits.",
      "textOtherSearchTypes": "In the multi-layer FCS search the supported layers and in the lexical search the supported fields filter on the supported features like, e. g. part of speech or lemma in addition to the other filter options."
    },
    "moreHelp": {
      "title": "More help",
      "text": "More detailed information on using FCS Aggregator is available at the <0>Content Search: Tutorial at CLARIN.eu</0>. If you still cannot find an answer to your question, or if want to send a feedback, you can write to the <1>CLARIN FCS Helpdesk</1>."
    },
    "icons": {
